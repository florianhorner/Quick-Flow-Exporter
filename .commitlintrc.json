{
  "_comment": "Commitlint configuration. Contributor rules are documented in CONTRIBUTING.md. The vendored rules in .config/commit-rules.json include local adaptations recorded in .config/commit-rules.meta.json.",
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "test",
        "chore",
        "ci",
        "build",
        "perf",
        "revert"
      ]
    ],
    "subject-case": [0],
    "subject-empty": [2, "never"],
    "subject-full-stop": [2, "never", "."],
    "header-max-length": [2, "always", 72],
    "body-max-line-length": [0],
    "footer-max-line-length": [0]
  },
  "plugins": [
    {
      "rules": {
        "engineering-standards-rules": "./.config/commit-rules.json"
      }
    }
  ]
}
